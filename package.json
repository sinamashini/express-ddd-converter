  "description": "It is a simple express app that handles different conversions like PDF to Markdown, Markdown to PDF, and more.",
  "main": "public/main.js",
  "scripts": {
    "build": "tsc --outDir public",
    "start": "node public/main.js",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
