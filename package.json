{
  "name": "express-ddd-converter",
  "version": "1.0.0",
  "description": "It is a simple express app that handles different conversions like PDF to Markdown, Markdown to PDF, and more.",
  "main": "dist/main.js",
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "start": "node dist/main.js",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "cleanup": "node scripts/cleanup.js",
    "cleanup:daemon": "node scripts/cleanup.js --daemon"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@opendocsg/pdf2md": "^0.2.1",
    "express": "^5.1.0",
    "md-to-pdf": "^5.2.4",
    "multer": "^2.0.1",
    "node-cron": "^3.0.2",
    "pdf-parse": "^1.1.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^4.6.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.2",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.29",
    "@types/node-cron": "^3.0.11",
    "@types/pdf-parse": "^1.1.5",
    "@types/swagger-ui-express": "^4.1.8",
    "rimraf": "^6.0.1"
  }
}
